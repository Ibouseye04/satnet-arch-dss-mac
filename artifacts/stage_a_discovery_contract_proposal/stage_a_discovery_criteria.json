    {
      "can_influence_stage_b": false,
      "criterion_id": "HOLD-005",
      "description": "Confirm global control",
      "failure_consequence": "STAGE_A_HOLDOUT_NOT_CONFIRMED",
      "input_partition": "sealed_holdout",
      "metric": "global controls with zero of five non-breach",
      "operator": "equals",
      "scientific_rationale": "Population-shift check",
      "threshold": 1

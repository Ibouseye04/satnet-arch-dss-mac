      "threshold": 6
    },
    {
      "can_influence_stage_b": false,
      "criterion_id": "HOLD-002",
      "description": "Complete fixed holdout block",
      "failure_consequence": "STAGE_A_HOLDOUT_NOT_CONFIRMED",
      "input_partition": "sealed_holdout",
      "metric": "successful fixed-identity designs/runs",
      "operator": "equals",
      "scientific_rationale": "Operational confirmation",
      "threshold": {
        "designs": 5,

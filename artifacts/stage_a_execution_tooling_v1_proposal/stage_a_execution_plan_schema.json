{
  "$id": "https://satnet.invalid/schema/stage_a_execution_plan_v2.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_contract_hash": {},
    "authorization_hash": {},
    "campaign_manifest_hash": {},
    "contract_hash": {},
    "design_count": {
      "minimum": 1,
      "type": "integer"
    },
    "executable_inventory_hash": {},
    "operation": {
      "enum": [
        "PLAN",
        "GENERATE",
        "REPLAY",
        "ACCEPT"
      ]
    },
    "output_roots": {},
    "partition": {
      "enum": [
        "development",
        "validation"
      ]
    },
    "plan_hash": {},
    "run_count": {
      "minimum": 1,
      "type": "integer"
    },
    "runs": {
      "items": {
        "properties": {
          "design_construction_seed": {
            "type": "integer"
          },
          "ground_failure_seed": {
            "type": "integer"
          },
          "ground_selection_seed": {
            "type": "integer"
          },
          "satellite_failure_seed": {
            "type": "integer"
          }
        },
        "required": [
          "design_construction_seed",
          "ground_selection_seed",
          "satellite_failure_seed",
          "ground_failure_seed"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "schema_identifier": {
      "const": "satnet.stage_a.execution_plan.v2"
    },
    "source_generation_ledger_byte_length": {},
    "source_generation_ledger_relative_path": {},
    "source_generation_ledger_sha256": {},
    "source_replay_ledger_byte_length": {},
    "source_replay_ledger_relative_path": {},
    "source_replay_ledger_sha256": {},
    "stable_executable_commit": {},
    "tooling_proposal_hash": {}
  },
  "required": [
    "artifact_contract_hash",
    "authorization_hash",
    "campaign_manifest_hash",
    "contract_hash",
    "design_count",
    "executable_inventory_hash",
    "operation",
    "output_roots",
    "partition",
    "plan_hash",
    "run_count",
    "runs",
    "schema_identifier",
    "source_generation_ledger_byte_length",
    "source_generation_ledger_relative_path",
    "source_generation_ledger_sha256",
    "source_replay_ledger_byte_length",
    "source_replay_ledger_relative_path",
    "source_replay_ledger_sha256",
    "stable_executable_commit",
    "tooling_proposal_hash"
  ],
  "title": "stage_a_execution_plan_v2",
  "type": "object"
}

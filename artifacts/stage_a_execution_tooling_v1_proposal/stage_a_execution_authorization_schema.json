{
  "$id": "https://satnet.invalid/schema/stage_a_execution_authorization_v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authorization_date": {
      "minLength": 1,
      "type": "string"
    },
    "authorization_id": {
      "minLength": 1,
      "type": "string"
    },
    "authorization_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "authorization_status": {
      "const": "AUTHORIZED"
    },
    "authorization_version": {
      "minLength": 1,
      "type": "string"
    },
    "authorized_acceptance_root": {
      "minLength": 1,
      "type": "string"
    },
    "authorized_artifact_contract_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "authorized_contract_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "authorized_contract_tag": {
      "minLength": 1,
      "type": "string"
    },
    "authorized_executable_inventory_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "authorized_frozen_commit": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "authorized_generation_root": {
      "minLength": 1,
      "type": "string"
    },
    "authorized_operation": {
      "enum": [
        "PLAN",
        "GENERATE",
        "REPLAY",
        "ACCEPT"
      ]
    },
    "authorized_partition": {
      "enum": [
        "development",
        "validation"
      ]
    },
    "authorized_replay_root": {
      "minLength": 1,
      "type": "string"
    },
    "authorized_run_count": {
      "minimum": 1,
      "type": "integer"
    },
    "authorized_run_ids": {
      "items": {
        "type": "integer"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "authorized_stable_executable_commit": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "authorized_tooling_proposal_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "authorizing_decision_reference": {
      "minLength": 1,
      "type": "string"
    },
    "independently_approved": {
      "const": true
    },
    "schema_identifier": {
      "const": "satnet.stage_a.execution_authorization.v1"
    }
  },
  "required": [
    "authorization_date",
    "authorization_id",
    "authorization_sha256",
    "authorization_status",
    "authorization_version",
    "authorized_acceptance_root",
    "authorized_artifact_contract_hash",
    "authorized_contract_hash",
    "authorized_contract_tag",
    "authorized_executable_inventory_hash",
    "authorized_frozen_commit",
    "authorized_generation_root",
    "authorized_operation",
    "authorized_partition",
    "authorized_replay_root",
    "authorized_run_count",
    "authorized_run_ids",
    "authorized_stable_executable_commit",
    "authorized_tooling_proposal_hash",
    "authorizing_decision_reference",
    "independently_approved",
    "schema_identifier"
  ],
  "title": "stage_a_execution_authorization_v1",
  "type": "object"
}
